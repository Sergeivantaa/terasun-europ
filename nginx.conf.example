server {
    listen 80;
    server_name terasun-europe.eu www.terasun-europe.eu;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name terasun-europe.eu www.terasun-europe.eu;

    ssl_certificate     /etc/ssl/terasun-europe.eu/fullchain.pem;
    ssl_certificate_key /etc/ssl/terasun-europe.eu/privkey.pem;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;
    gzip_min_length 1000;

    # Static assets — long cache
    location /_next/static/ {
        alias /var/www/terasun-europ/.next/static/;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Public files
    location /public/ {
        alias /var/www/terasun-europ/public/;
        expires 7d;
    }

    # Next.js app
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
